{
    "name": "pushinbr/pam-native-realtime",
    "description": "Laravel Echo style Pusher/Reverb channels and persistent native WebSockets for PAM Native.",
    "type": "pam-native-plugin",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.5",
        "pushinbr/pam-native": "^1.0.35"
    },
    "require-dev": {
        "pushinbr/pam-native-testing": "^0.2.0"
    },
    "autoload": {
        "psr-4": {
            "Pam\\Native\\Realtime\\": "src/"
        }
    },
    "extra": {
        "pam-native": {
            "plugin": "pam-native.plugin.json"
        }
    },
    "scripts": {
        "test": "php tests/run.php"
    },
    "config": {
        "platform-check": true,
        "sort-packages": true
    },
    "keywords": [
        "pam-native",
        "realtime",
        "pusher",
        "reverb",
        "laravel-echo",
        "websocket"
    ]
}
